# Variables beginning with VITE_ are visible in the browser bundle.
# Never place private keys, seed phrases, tokens, or credentials here.

VITE_EXECUTION_MODE=simulation_only
VITE_EXTERNAL_EXECUTION_AUTHORIZED=false

# GitHub public-repository adapter.
# The owner is normally detected from Codespaces or git origin.
# Tokens remain server-side and are optional for public repositories.
GITHUB_REPOSITORY_OWNER=
GITHUB_TOKEN=
BI_BLE_GITHUB_ADAPTER_PORT=8787
